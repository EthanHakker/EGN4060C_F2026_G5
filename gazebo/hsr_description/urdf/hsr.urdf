    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <origin rpy="0 0 0" xyz="0.125 0.18 0.075"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" velocity="13.3"/>
    <dynamics damping="0.01" friction="0"/>
