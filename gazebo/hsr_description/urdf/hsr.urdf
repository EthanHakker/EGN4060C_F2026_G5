    <collision>
      <!-- URDF cylinders are along Z; roll 90 deg puts the axis on Y -->
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.075"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin rpy="0 0 0" xyz="-0.125 0.18 0.075"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" velocity="13.3"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>
  <link name="rear_right_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 1.60585019e-18"/>
      <mass value="0.678584013"/>
      <inertia ixx="0.00104473664" ixy="-1.96701294e-36" ixz="0" iyy="0.00190851754" iyz="0" izz="0.00104473664"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hsr_description/meshes/wheel.stl"/>
      </geometry>
      <material name="tyre_black"/>
    </visual>
    <collision>
      <!-- URDF cylinders are along Z; roll 90 deg puts the axis on Y -->
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.075"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin rpy="0 0 0" xyz="-0.125 -0.18 0.075"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" velocity="13.3"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>
  <!-- ===== 2D LiDAR ===== -->
  <link name="lidar_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-7.30907219e-19 0 0.02"/>
      <mass value="0.180248878"/>
      <inertia ixx="8.74019301e-05" ixy="0" ixz="0" iyy="8.74019301e-05" iyz="-2.61243906e-37" izz="0.000126737493"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hsr_description/meshes/lidar.stl"/>
      </geometry>
      <material name="lidar_blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
        <cylinder length="0.04" radius="0.0375"/>
      </geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0.08 0 0.205"/>
  </joint>
  <!-- Scan plane frame: Z = deck_z + standoff + scan_offset = 0.225 m -->
  <link name="laser_frame"/>
  <joint name="laser_frame_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="laser_frame"/>
    <origin rpy="0 0 0" xyz="0 0 0.02"/>
  </joint>
  <!-- ===== Camera pan head (revolute about Z) ===== -->
  <link name="camera_pan_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-3.97519433e-19 1.98759716e-19 0.0164421881"/>
      <mass value="0.0679191329"/>
      <inertia ixx="2.0717736e-05" ixy="-2.6366382e-22" ixz="1.71993166e-22" iyy="1.7147736e-05" iyz="1.24934473e-22" izz="2.6654104e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hsr_description/meshes/camera_pan_head.stl"/>
      </geometry>
      <material name="pan_dark"/>
    </visual>
    <collision name="turntable_collision">
      <origin rpy="0 0 0" xyz="0 0 0.0125"/>
      <geometry>
        <cylinder length="0.025" radius="0.025"/>
      </geometry>
    </collision>
    <collision name="seat_plate_collision">
      <origin rpy="0 0 0" xyz="0 0 0.0275"/>
      <geometry>
        <box size="0.05 0.07 0.005"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="camera_pan_link"/>
    <origin rpy="0 0 0" xyz="-0.14 0 0.27"/>
    <axis xyz="0 0 1"/>
    <limit effort="1" lower="-3.14159265" upper="3.14159265" velocity="2"/>
    <dynamics damping="0.05"/>
  </joint>
  <!-- ===== Camera (rides on pan head) ===== -->
  <link name="camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.000331193763 1.60005346e-36 2.49061299e-20"/>
      <mass value="0.120942212"/>
      <inertia ixx="5.80097356e-05" ixy="-4.28997448e-39" ixz="-2.23085068e-22" iyy="3.70821348e-05" iyz="-1.72794721e-21" izz="6.31877598e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hsr_description/meshes/camera.stl"/>
      </geometry>
      <material name="camera_orange"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.045 0.065 0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_pan_link"/>
    <child link="camera_link"/>
    <!-- camera body centre sits camera_H/2 above the seat plate -->
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
  </joint>
  <!-- ROS optical convention (Z forward, X right, Y down) at the lens face -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0.0275 0 0"/>
  </joint>
  <!-- ===== Front distance sensor (body tilted 30 deg down in CAD) ===== -->
  <link name="front_range_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0121696877 -4.74506619e-19 0.00443717098"/>
      <mass value="0.0248935182"/>
      <inertia ixx="5.51442153e-06" ixy="-7.37729581e-25" ixz="-2.3891345e-07" iyy="3.01057272e-06" iyz="-1.31809396e-22" izz="5.5649727e-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hsr_description/meshes/front_range_sensor.stl"/>
      </geometry>
      <material name="range_green"/>
    </visual>
    <!-- no separate collision: enclosed by base_link front_guard_collision -->
  </link>
  <joint name="front_range_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_range_link"/>
    <origin rpy="0 0 0" xyz="0.225 0 0.16"/>
  </joint>
  <!-- Beam frame: +X along the beam, pitched 30 deg below horizontal (+pitch = nose down) -->
  <link name="front_range_beam_frame"/>
  <joint name="front_range_beam_joint" type="fixed">
    <parent link="front_range_link"/>
    <child link="front_range_beam_frame"/>
    <origin rpy="0 0.5235987755982988 0" xyz="0 0 0"/>
  </joint>
  <gazebo reference="front_left_wheel_link">
    <mu1>1</mu1>
    <mu2>0.8</mu2>
    <kp>1000000</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <mu1>1</mu1>
    <mu2>0.8</mu2>
    <kp>1000000</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <mu1>1</mu1>
    <mu2>0.8</mu2>
    <kp>1000000</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <mu1>1</mu1>
    <mu2>0.8</mu2>
    <kp>1000000</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="base_link">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
  </gazebo>
  <!-- ===== 2D LiDAR: scan plane at laser_frame (Z = 0.225 m) ===== -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>laser_frame</gz_frame_id>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <!-- exactly 1 deg spacing, no duplicated beam at +/-180 deg -->
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.12413936</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <!-- ===== Pan camera (looks along camera_link +X) ===== -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <topic>/camera/image_raw</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <pose>0.0275 0 0 0 0 0</pose>
      <camera name="pan_camera">
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <horizontal_fov>1.2217</horizontal_fov>
        <!-- 70 deg -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>30.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>
  <!-- ===== Front distance sensor: narrow cone along front_range_beam_frame +X (30 deg down) =====
       Modelled as a 5-ray gpu_lidar spanning ~15 deg (ultrasonic/ToF-like). Publishes a
       5-sample LaserScan; take the minimum valid range as the distance reading. -->
  <gazebo reference="front_range_beam_frame">
    <sensor name="front_range" type="gpu_lidar">
      <gz_frame_id>front_range_beam_frame</gz_frame_id>
      <topic>/front_range/scan</topic>
      <update_rate>20</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.1309</min_angle>
            <max_angle>0.1309</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.005</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <!-- ===== Model plugins ===== -->
  <gazebo>
    <!-- Skid-steer drive: both wheels on each side driven together -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <!-- effective (slip-calibrated) separation, not the physical 0.36 m track -->
      <wheel_separation>0.514</wheel_separation>
      <wheel_radius>0.075</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <max_linear_velocity>0.8</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>
    <!-- Publishes all joint positions/velocities (wheels + pan) -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
    <!-- Camera pan: send a target angle (rad) as gz.msgs.Double / std_msgs/Float64 -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>camera_pan_joint</joint_name>
      <topic>/camera_pan/cmd_pos</topic>
      <p_gain>3.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.05</d_gain>
      <cmd_max>1</cmd_max>
      <cmd_min>-1</cmd_min>
    </plugin>
  </gazebo>
</robot>
