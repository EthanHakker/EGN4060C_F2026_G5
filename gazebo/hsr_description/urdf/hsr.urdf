  <!-- ===== base_link: chassis + LiDAR mount + camera mast + sensor guard (rigid) ===== -->
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00260489433 -5.13935256e-18 0.119233494"/>
      <mass value="6.10375348"/>
