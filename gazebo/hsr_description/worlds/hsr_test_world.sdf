<?xml version="1.0"?>
<!--
  Simple test arena for the HSR robot: 8 m x 8 m room with interior walls and obstacles,
  suitable for first SLAM / A* navigation tests. Loads the systems the robot needs
  (physics, sensors with ogre2 rendering, user commands, scene broadcaster).
  To test CNN human detection, uncomment the <include> of a person model at the bottom
  (downloads from Gazebo Fuel on first run - needs internet).
-->
<sdf version="1.9">
  <world name="hsr_test_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.55 0.55 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Room: 8 x 8 m, 1 m high walls, 0.1 m thick -->
    <model name="room">
      <static>true</static>
      <link name="walls">
        <collision name="north"><pose>4.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 8.2 1.0</size></box></geometry></collision>
        <visual name="north_v"><pose>4.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 8.2 1.0</size></box></geometry><material><ambient>0.82 0.8 0.76 1</ambient><diffuse>0.82 0.8 0.76 1</diffuse></material></visual>
        <collision name="south"><pose>-4.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 8.2 1.0</size></box></geometry></collision>
        <visual name="south_v"><pose>-4.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 8.2 1.0</size></box></geometry><material><ambient>0.82 0.8 0.76 1</ambient><diffuse>0.82 0.8 0.76 1</diffuse></material></visual>
        <collision name="east"><pose>0 -4.05 0.5 0 0 0</pose><geometry><box><size>8.0 0.1 1.0</size></box></geometry></collision>
        <visual name="east_v"><pose>0 -4.05 0.5 0 0 0</pose><geometry><box><size>8.0 0.1 1.0</size></box></geometry><material><ambient>0.82 0.8 0.76 1</ambient><diffuse>0.82 0.8 0.76 1</diffuse></material></visual>
        <collision name="west"><pose>0 4.05 0.5 0 0 0</pose><geometry><box><size>8.0 0.1 1.0</size></box></geometry></collision>
        <visual name="west_v"><pose>0 4.05 0.5 0 0 0</pose><geometry><box><size>8.0 0.1 1.0</size></box></geometry><material><ambient>0.82 0.8 0.76 1</ambient><diffuse>0.82 0.8 0.76 1</diffuse></material></visual>
        <!-- interior partition with a 1 m doorway -->
        <collision name="partition_a"><pose>1.5 2.25 0.5 0 0 0</pose><geometry><box><size>0.1 3.5 1.0</size></box></geometry></collision>
        <visual name="partition_a_v"><pose>1.5 2.25 0.5 0 0 0</pose><geometry><box><size>0.1 3.5 1.0</size></box></geometry><material><ambient>0.82 0.8 0.76 1</ambient><diffuse>0.82 0.8 0.76 1</diffuse></material></visual>
        <collision name="partition_b"><pose>1.5 -2.75 0.5 0 0 0</pose><geometry><box><size>0.1 2.5 1.0</size></box></geometry></collision>
        <visual name="partition_b_v"><pose>1.5 -2.75 0.5 0 0 0</pose><geometry><box><size>0.1 2.5 1.0</size></box></geometry><material><ambient>0.82 0.8 0.76 1</ambient><diffuse>0.82 0.8 0.76 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Obstacles: debris boxes and a pillar -->
    <model name="debris_box_1">
      <static>true</static><pose>2.0 -0.2 0.2 0 0 0.4</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.6 0.4 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.4 0.4</size></box></geometry>
          <material><ambient>0.5 0.3 0.15 1</ambient><diffuse>0.5 0.3 0.15 1</diffuse></material></visual>
      </link>
    </model>
    <model name="debris_box_2">
      <static>true</static><pose>-1.8 1.6 0.15 0 0 -0.3</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.5 0.5 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.3</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static><pose>-1.5 -2.0 0.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Optional: a person for CNN detection tests (Gazebo Fuel, needs internet on first run)
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>victim_1</name>
      <pose>3.0 3.0 0 0 0 -2.3</pose>
    </include>
    -->
  </world>
</sdf>
